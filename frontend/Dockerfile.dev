# ========================================
# Effisio フロントエンド開発環境 Dockerfile
# ========================================

# Node.js 22.23.4 は CVE-2026-111497 の修正版。frontend/.nvmrc と揃える。
FROM node:22.23.4-alpine

# 作業ディレクトリ
WORKDIR /app

# package.json と package-lock.json をコピー
COPY package*.json ./

# 依存関係インストール
RUN npm ci

# ソースコードをコピー
COPY . .

# ポート公開
EXPOSE 3000

# 開発サーバー起動
CMD ["npm", "run", "dev"]
